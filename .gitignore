# Secrets — never commit
*service-account*.json
*credentials*.json
.env
config/gcp-key.json

# Python
.venv/
__pycache__/
*.pyc

# Raw source archive stays local (large, copyright-ambiguous)
data/raw-documents/
*.zip

# Excel lock files
~$*

# Raw lookup snapshots stay local: the World Cider Map carries Notes, TTB
# numbers and Place IDs that have no business in a public repo. Only the
# derived data/reference/producers_geo.csv is committed.
data/snapshot/_lookups/

# The World Cider Map snapshot stays local: its Google Places formulas embed an
# API key, and it carries Notes/TTB fields. Only data/reference/producers_geo.csv
# is committed. Competition grain tabs ARE committed - fetch.py pulls only the
# tab named in sheet_tables.csv, so nothing incidental comes with them.
data/snapshot/_lookups/

# Saved source pages stay local. data/source/web/ mirrors 160+ MB of other
# people's competition announcements for archival use. What is committed is
# the manifest: which URL each file came from, when, how big, and its hash.
# The rule matches <competition>/<year>/<file> and so leaves the manifests and
# this directory's README tracked. The handful of pages the parsers read were
# committed before this rule and stay tracked, since .gitignore has no say
# over files already in the index.
data/source/web/*/*/*
