# Secrets — never commit
*service-account*.json
*credentials*.json
.env
config/gcp-key.json

# Python
.venv/
__pycache__/
*.pyc

# Raw source archive stays local (large, copyright-ambiguous)
data/raw-documents/
*.zip

# Excel lock files
~$*

# Raw lookup snapshots stay local: the World Cider Map carries Notes, TTB
# numbers and Place IDs that have no business in a public repo. Only the
# derived data/reference/producers_geo.csv is committed.
data/snapshot/_lookups/
