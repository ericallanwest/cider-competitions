# The pipeline writes LF on every platform. Without this, a Windows checkout
# gets CRLF and the CI drift check ("generated files are out of date") fails
# against a Linux runner that regenerates them with LF.
* text=auto eol=lf
*.png binary
*.jpg binary

# Captured source pages and PDFs are archival copies: keep their bytes exactly
# as fetched so the sha256 in data/source/web/manifest.csv stays true.
data/source/web/** -text
data/source/web/manifest.csv text eol=lf
data/source/web/*/manifest.csv text eol=lf
data/source/web/README.md text eol=lf
